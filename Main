local key = getgenv().PandaKey

local function fetch(url)
    local okGet, src = pcall(game.HttpGet, game, url)
    if not okGet then
        warn("[dbg] HttpGet failed:", url, src)
        return
    end
    local fn, err = loadstring(src)
    if not fn then
        warn("[dbg] compile failed:", url, err)
        return
    end
    local ok, res = xpcall(fn, debug.traceback)
    if not ok then
        warn("[dbg] runtime error:", url, res)
        return
    end
    return res
end

if type(key) ~= "string" or key:gsub("%s", "") == "" then
    return warn('[Panda] No key set. Use getgenv().PandaKey = "YOUR_KEY" before loading.')
end

local okLib, PUSL = pcall(function()
    return fetch("https://secure.pandauth.com/pv4/lib")
end)

if not okLib or type(PUSL) ~= "table" or type(PUSL.configure) ~= "function" then
    return warn("[Panda] Library failed to initialize.")
end

PUSL.configure({ serviceId = "king" })

local okVal, result = pcall(PUSL.validate, (key:gsub("^%s+", ""):gsub("%s+$", "")))

if not okVal or type(result) ~= "table" or not result.success then
    local okUrl, url = pcall(PUSL.getKeyUrl)
    warn("[Panda] Invalid key. Get a key: " .. (okUrl and tostring(url) or "unavailable"))
    return
end

print("[Panda] Authenticated. Premium:", result.isPremium)

local function openDiscord()
    pcall(function()
        if isfile and writefile and not isfile("invited_butter.txt") then
            writefile("invited_butter.txt", "true")

            local discordInvite = "https://discord.gg/vFjNvBGTBJ"

            local http_request = (syn and syn.request)
                or (http and http.request)
                or request

            if http_request then
                http_request({
                    Url = "http://127.0.0.1:6463/rpc?v=1",
                    Method = "POST",
                    Headers = {
                        ["Content-Type"] = "application/json",
                        ["Origin"] = "https://discord.com"
                    },
                    Body = game:GetService("HttpService"):JSONEncode({
                        cmd = "INVITE_BROWSER",
                        args = {
                            code = string.match(discordInvite, "discord%.com/invite/(%w+)")
                        },
                        nonce = game:GetService("HttpService"):GenerateGUID(false)
                    })
                })
            else
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = "Executor Not Supported",
                    Text = "Join manually: " .. discordInvite,
                    Duration = 5
                })
            end
        end
    end)
end

if game.PlaceId == 130641102725850 then -- mog or die
    openDiscord()
    fetch("https://raw.githubusercontent.com/shyoma30/shyhubv2/refs/heads/main/kinghub")

elseif game.PlaceId == 134820818906933 then -- mog evo
    openDiscord()
    fetch("https://raw.githubusercontent.com/shyoma30/shyhubv2/refs/heads/main/mog%20evo")

elseif game.PlaceId == 142823291 then -- mm2
    openDiscord()
    fetch("https://raw.githubusercontent.com/shyoma30/shyhubv2/refs/heads/main/Shystar")

elseif game.PlaceId == 537413528 then -- babft
    openDiscord()
    fetch("https://raw.githubusercontent.com/shyoma30/shyhubv2/refs/heads/main/Babftfarm")

elseif game.PlaceId == 155615604 then -- prison life
    openDiscord()
    fetch("https://raw.githubusercontent.com/shyoma30/shyhubv2/refs/heads/main/prisonlife")
end
